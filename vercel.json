{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/exotel/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "env": {
    "MONGODB_URI": "${MONGODB_URI}",
    "EXOTEL_SID": "${EXOTEL_SID}",
    "EXOTEL_TOKEN": "${EXOTEL_TOKEN}",
    "EXOTEL_FROM_NUMBER": "${EXOTEL_FROM_NUMBER}",
    "OPENAI_API_KEY": "${OPENAI_API_KEY}",
    "GOOGLE_CALENDAR_API_KEY": "${GOOGLE_CALENDAR_API_KEY}",
    "BASE_URL": "${BASE_URL}",
    "PORT": "${PORT}"
  },
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  }
}
